<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NextCommander.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="FmMarkedBrush" Color="#D32F2F" />
          <SolidColorBrush x:Key="FmHiddenBrush" Color="#8A8A8A" />
          <SolidColorBrush x:Key="FmFolderBrush" Color="#E0A526" />
          <SolidColorBrush x:Key="FmFileBrush" Color="#7A8794" />
          <SolidColorBrush x:Key="FmPanelHeaderBrush" Color="#E9EDF2" />
          <SolidColorBrush x:Key="FmDriveBarBrush" Color="#E9EDF2" />
          <SolidColorBrush x:Key="FmBarLineBrush" Color="#E9EDF2" />
          <SolidColorBrush x:Key="FmActiveAccentBrush" Color="#2F6FDB" />
          <SolidColorBrush x:Key="FmStatusBrush" Color="#F3F5F8" />
          <SolidColorBrush x:Key="FmMenuBarBrush" Color="Transparent" />
          <SolidColorBrush x:Key="FmToolBarBrush" Color="Transparent" />
          <SolidColorBrush x:Key="FmTabStripBrush" Color="#F3F5F8" />
          <SolidColorBrush x:Key="FmTabActiveBrush" Color="#E9EDF2" />
          <!-- menu items under the mouse: the active tab's color (theme key Menu.HoverBackground) -->
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#E9EDF2" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#E9EDF2" />
          <SolidColorBrush x:Key="FmActivePathBrush" Color="#CCE4F7" />
          <SolidColorBrush x:Key="FmMenuBarForegroundBrush" Color="#1B1B1B" />
          <SolidColorBrush x:Key="FmListBackgroundBrush" Color="Transparent" />
          <SolidColorBrush x:Key="FmDriveIconBrush" Color="#6B7785" />
          <SolidColorBrush x:Key="FmListTextBrush" Color="#1B1B1B" />
          <SolidColorBrush x:Key="FmCursorTextBrush" Color="#000000" />
          <SolidColorBrush x:Key="FmListBackground2Brush" Color="Transparent" />
          <SolidColorBrush x:Key="FmTabPassiveLineBrush" Color="#732F6FDB" />
          <SolidColorBrush x:Key="FmFunctionKeyBorderBrush" Color="#33000000" />
        </ResourceDictionary>
        <!-- Dark: only the defaults under a dark theme file (Themes/dark.json sets the real colors) -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="FmMarkedBrush" Color="#FF8A80" />
          <SolidColorBrush x:Key="FmHiddenBrush" Color="#8A8A8A" />
          <SolidColorBrush x:Key="FmFolderBrush" Color="#E0B050" />
          <SolidColorBrush x:Key="FmFileBrush" Color="#B0B8C0" />
          <SolidColorBrush x:Key="FmPanelHeaderBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="FmDriveBarBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="FmBarLineBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="FmActiveAccentBrush" Color="#4C9AFF" />
          <SolidColorBrush x:Key="FmStatusBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="FmMenuBarBrush" Color="Transparent" />
          <SolidColorBrush x:Key="FmToolBarBrush" Color="Transparent" />
          <SolidColorBrush x:Key="FmTabStripBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="FmTabActiveBrush" Color="#1F1F1F" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#1F1F1F" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#1F1F1F" />
          <SolidColorBrush x:Key="FmActivePathBrush" Color="#1F3F66" />
          <SolidColorBrush x:Key="FmMenuBarForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="FmListBackgroundBrush" Color="Transparent" />
          <SolidColorBrush x:Key="FmDriveIconBrush" Color="#9DA5B4" />
          <SolidColorBrush x:Key="FmListTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="FmCursorTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="FmListBackground2Brush" Color="Transparent" />
          <SolidColorBrush x:Key="FmTabPassiveLineBrush" Color="#8C4C9AFF" />
          <SolidColorBrush x:Key="FmFunctionKeyBorderBrush" Color="#33FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NextCommander/Styles/MenuIcons.axaml" />
        <ResourceInclude Source="avares://NextCommander/Styles/DesignTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <x:Double x:Key="FmPanelFontSize">13</x:Double>
      <x:Double x:Key="FmIconSize">16</x:Double>
      <Thickness x:Key="FmIconMargin">6,0,2,0</Thickness>
