<!--
  The colors of the tool windows built after the templates (copy dialog, find files, multi-rename; docs/design.md). They
  follow the color theme: surfaces, text, lines and fields take the colors of the theme's Fluent palette (Window.Background,
  Window.Text, Controls.*), so a theme file changes them too. Colors made from the theme's accent (its soft tint, the
  focus ring, text on the accent) are set by Services/Design/DesignColors.cs whenever a theme is applied. Only the state
  colors (ok, warn, bad) are the design's own, in a light and a dark tone.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="NcAccentHoverBrush" Color="{DynamicResource SystemAccentColorDark1}" />
      <SolidColorBrush x:Key="NcOkBrush" Color="#17804F" />
      <SolidColorBrush x:Key="NcOkSoftBrush" Color="#1A17804F" />
      <SolidColorBrush x:Key="NcWarnBrush" Color="#B26B00" />
      <SolidColorBrush x:Key="NcWarnSoftBrush" Color="#1AB26B00" />
      <SolidColorBrush x:Key="NcBadBrush" Color="#C4302B" />
      <SolidColorBrush x:Key="NcBadSoftBrush" Color="#1AC4302B" />
      <BoxShadows x:Key="NcBadRing">0 0 0 3 #1AC4302B</BoxShadows>
      <!-- the main window (the user's template, 22 November 2026): lines, hover, press, the raised chip -->
      <SolidColorBrush x:Key="NcMwStrokeBrush" Color="#13000000" />
      <SolidColorBrush x:Key="NcMwStrongStrokeBrush" Color="#24000000" />
      <SolidColorBrush x:Key="NcMwHoverBrush" Color="#0A000000" />
      <SolidColorBrush x:Key="NcMwPressBrush" Color="#14000000" />
      <SolidColorBrush x:Key="NcMwChipBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="NcMwCardBrush" Color="#FBFBFB" />
      <!-- the accent tints of the main window; DesignColors.Update makes them from the theme's panel accent -->
      <SolidColorBrush x:Key="NcMwCursorBrush" Color="#1F2F6FDB" />
      <SolidColorBrush x:Key="NcMwCursorLineBrush" Color="#802F6FDB" />
      <SolidColorBrush x:Key="NcMwCursorInactiveBrush" Color="#102F6FDB" />
      <SolidColorBrush x:Key="NcMwCursorInactiveLineBrush" Color="#402F6FDB" />
      <SolidColorBrush x:Key="NcMwAccentSoftBrush" Color="#1A2F6FDB" />
      <BoxShadows x:Key="NcMwChipShadow">0 1 2 0 #1F000000</BoxShadows>
      <BoxShadows x:Key="NcMwPopupShadow">0 12 36 0 #2E000000</BoxShadows>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="NcAccentHoverBrush" Color="{DynamicResource SystemAccentColorLight1}" />
      <SolidColorBrush x:Key="NcOkBrush" Color="#4CC38A" />
      <SolidColorBrush x:Key="NcOkSoftBrush" Color="#244CC38A" />
      <SolidColorBrush x:Key="NcWarnBrush" Color="#E9A23B" />
      <SolidColorBrush x:Key="NcWarnSoftBrush" Color="#24E9A23B" />
      <SolidColorBrush x:Key="NcBadBrush" Color="#FF6B6B" />
      <SolidColorBrush x:Key="NcBadSoftBrush" Color="#24FF6B6B" />
      <BoxShadows x:Key="NcBadRing">0 0 0 3 #24FF6B6B</BoxShadows>
      <SolidColorBrush x:Key="NcMwStrokeBrush" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="NcMwStrongStrokeBrush" Color="#21FFFFFF" />
      <SolidColorBrush x:Key="NcMwHoverBrush" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="NcMwPressBrush" Color="#17FFFFFF" />
      <SolidColorBrush x:Key="NcMwChipBrush" Color="#2F2F2F" />
      <SolidColorBrush x:Key="NcMwCardBrush" Color="#262626" />
      <SolidColorBrush x:Key="NcMwCursorBrush" Color="#244C9AFF" />
      <SolidColorBrush x:Key="NcMwCursorLineBrush" Color="#804C9AFF" />
      <SolidColorBrush x:Key="NcMwCursorInactiveBrush" Color="#144C9AFF" />
      <SolidColorBrush x:Key="NcMwCursorInactiveLineBrush" Color="#404C9AFF" />
      <SolidColorBrush x:Key="NcMwAccentSoftBrush" Color="#214C9AFF" />
      <BoxShadows x:Key="NcMwChipShadow">0 1 2 0 #4D000000</BoxShadows>
      <BoxShadows x:Key="NcMwPopupShadow">0 12 36 0 #99000000</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Window.Background: the window and the fields -->
  <SolidColorBrush x:Key="NcSurfaceBrush" Color="{DynamicResource SystemAltHighColor}" />
  <SolidColorBrush x:Key="NcFieldBrush" Color="{DynamicResource SystemAltHighColor}" />
  <!-- Controls.Background / Controls.HoverBackground: bars, the results area, buttons -->
  <SolidColorBrush x:Key="NcSurface2Brush" Color="{DynamicResource SystemChromeLowColor}" />
  <SolidColorBrush x:Key="NcSurface3Brush" Color="{DynamicResource SystemChromeMediumLowColor}" />
  <!-- Window.Text and its tones -->
  <SolidColorBrush x:Key="NcTextBrush" Color="{DynamicResource SystemBaseHighColor}" />
  <SolidColorBrush x:Key="NcMutedBrush" Color="{DynamicResource SystemBaseMediumHighColor}" />
  <SolidColorBrush x:Key="NcFaintBrush" Color="{DynamicResource SystemBaseMediumColor}" />
  <SolidColorBrush x:Key="NcLineBrush" Color="{DynamicResource SystemBaseLowColor}" />
  <!-- Controls.Border -->
  <SolidColorBrush x:Key="NcLineStrongBrush" Color="{DynamicResource SystemChromeHighColor}" />
  <!-- Accent -->
  <SolidColorBrush x:Key="NcAccentBrush" Color="{DynamicResource SystemAccentColor}" />
  <!-- until DesignColors sets them from the theme's accent -->
  <SolidColorBrush x:Key="NcAccentSoftBrush" Color="#1A0F6CDB" />
  <SolidColorBrush x:Key="NcOnAccentBrush" Color="#FFFFFF" />
  <BoxShadows x:Key="NcFocusRing">0 0 0 3 #1A0F6CDB</BoxShadows>
  <FontFamily x:Key="NcMonoFont">Cascadia Code,Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace</FontFamily>
</ResourceDictionary>
