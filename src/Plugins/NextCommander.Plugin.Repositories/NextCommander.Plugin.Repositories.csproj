<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GitHub and GitLab repositories as a plugin: a repository's branches, tags, releases and files in a panel
    (github://owner/name/..., gitlab://group/project/...), read-only through the hosts' REST APIs, without cloning.
    No package: HttpClient with the program's proxy. The application builds it and copies it with plugin.json and its
    languages folder into plugins/repositories next to the program.
  -->
  <PropertyGroup>
    <RootNamespace>NextCommander.Plugin.Repositories</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\NextCommander.Core\NextCommander.Core.csproj" Private="false" />
  </ItemGroup>
  <!-- plugin.json and languages are taken from this folder by the application's build (not copied here: they would land next to the program too) -->
  <ItemGroup>
    <InternalsVisibleTo Include="NextCommander.Core.Tests" />
  </ItemGroup>
</Project>
