<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1515/CA1711 etc. are too noisy for an application codebase -->
    <NoWarn>$(NoWarn);CA1515;CA1711;CA1716;CA1720;CA1805;CA1812;CA1848;CA1852;CA2007;CA1031;CA1062;CA1303;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1724;CA1819;CA1001;CA1063;CA1816;CA2000;CA5394;CA1859;CA1002;CA1822;CA1050;CA1034;CA1708;CA1056;CA1054;CA1055;CA2234;CA1823</NoWarn>
    <Authors>Muhammed Şahin</Authors>
    <Product>NextCommander</Product>
    <Copyright>© 2026 NextCommander</Copyright>
    <!--
      Version: major.minor.build. Major and minor are set here by hand; the build number counts the git commits:
      NcBuildNumberStart at the commit number NcBuildNumberStartCommit (the commit that introduced it), one more with
      every commit after it. Without git (a source copy) the build number is NcBuildNumberStart.
      The NcVersion target sets it before the assembly attributes are written; build/publish.ps1 reads it with
      "dotnet msbuild -t:NcVersion -getProperty:Version".
    -->
    <NcVersionMajorMinor>1.0</NcVersionMajorMinor>
    <NcBuildNumberStart>1000</NcBuildNumberStart>
    <NcBuildNumberStartCommit>6</NcBuildNumberStartCommit>
    <Version>$(NcVersionMajorMinor).$(NcBuildNumberStart)</Version>
    <!-- no "+commit" suffix in the informational version: the app shows it as it is -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="NcVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;GetAssemblyAttributes">
    <Exec Command="git rev-list --count HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_NcCommitCount" />
      <Output TaskParameter="ExitCode" PropertyName="_NcGitExitCode" />
    </Exec>
    <PropertyGroup>
      <_NcBuildNumber>$(NcBuildNumberStart)</_NcBuildNumber>
      <_NcBuildNumber Condition="'$(_NcGitExitCode)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_NcCommitCount)', '^\d+$'))">$([MSBuild]::Add($(NcBuildNumberStart), $([MSBuild]::Subtract($(_NcCommitCount), $(NcBuildNumberStartCommit)))))</_NcBuildNumber>
      <Version>$(NcVersionMajorMinor).$(_NcBuildNumber)</Version>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
