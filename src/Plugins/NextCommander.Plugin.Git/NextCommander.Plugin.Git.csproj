<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Git as a plugin: the history of a repository as folders (git://) and the Git state of files as columns. It runs
    the installed git; the application builds it and copies it with plugin.json into plugins/git next to the program
    (NextCommander.App.csproj); it shares NextCommander.Core with the application.
  -->
  <PropertyGroup>
    <RootNamespace>NextCommander.Plugin.Git</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\NextCommander.Core\NextCommander.Core.csproj" Private="false" />
  </ItemGroup>
  <!-- plugin.json is taken from this folder by the application's build (not copied here: it would land next to the program too) -->
  <ItemGroup>
    <InternalsVisibleTo Include="NextCommander.Core.Tests" />
  </ItemGroup>
</Project>
