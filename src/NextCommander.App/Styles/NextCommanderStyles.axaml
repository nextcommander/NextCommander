<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NextCommander.App.ViewModels"
        xmlns:views="using:NextCommander.App.Views">

  <!-- Window chrome (VS Code style in dark mode) -->
  <Style Selector="Menu#MainMenu">
    <Setter Property="Background" Value="{DynamicResource FmMenuBarBrush}" />
  </Style>
  <Style Selector="Menu#MainMenu > MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource FmMenuBarForegroundBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- a top menu under the mouse or open looks like the selected folder tab: the tab's background and the accent line -->
  <Style Selector="Menu#MainMenu > MenuItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Menu#MainMenu > MenuItem:pointerover, Menu#MainMenu > MenuItem:open, Menu#MainMenu > MenuItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource FmActiveAccentBrush}" />
  </Style>
  <Style Selector="Menu#MainMenu > MenuItem:pointerover /template/ Border#PART_LayoutRoot, Menu#MainMenu > MenuItem:open /template/ Border#PART_LayoutRoot, Menu#MainMenu > MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource FmTabActiveBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FmActiveAccentBrush}" />
  </Style>
  <!-- the items of the drop-down and context menus the same way: the tab's background (Menu.HoverBackground) and an accent line on the left -->
  <Style Selector="Menu#MainMenu MenuItem MenuItem, ContextMenu MenuItem">
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Menu#MainMenu MenuItem MenuItem:pointerover, Menu#MainMenu MenuItem MenuItem:selected, Menu#MainMenu MenuItem MenuItem:open, ContextMenu MenuItem:pointerover, ContextMenu MenuItem:selected, ContextMenu MenuItem:open">
    <Setter Property="BorderBrush" Value="{DynamicResource FmActiveAccentBrush}" />
  </Style>
  <Style Selector="Menu#MainMenu MenuItem MenuItem:disabled, ContextMenu MenuItem:disabled">
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Menu#MainMenu > MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter, Menu#MainMenu > MenuItem:open /template/ ContentPresenter#PART_HeaderPresenter, Menu#MainMenu > MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource FmMenuBarForegroundBrush}" />
  </Style>

  <!-- Compact file list rows -->
  <Style Selector="DataGrid.files">
    <Setter Property="RowHeight" Value="{DynamicResource FmRowHeight}" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserReorderColumns" Value="True" />
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="CanUserSortColumns" Value="True" />
    <Setter Property="FontSize" Value="{DynamicResource FmPanelFontSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource FmPanelFontFamily}" />
    <!-- Transparent unless Color > background is set (default in the theme dictionaries) -->
    <Setter Property="Background" Value="{DynamicResource FmListBackgroundBrush}" />
  </Style>
  <!-- Configuration > Color (resources exist only when the user set a color); "alt" = every second row -->
  <Style Selector="DataGrid.files DataGridRow">
    <Setter Property="Background" Value="{DynamicResource FmListBackgroundBrush}" />
  </Style>
  <Style Selector="DataGrid.files DataGridRow.alt">
    <Setter Property="Background" Value="{DynamicResource FmListBackground2Brush}" />
  </Style>
  <!-- Show > Group by: the header of a group (its title in the name column) -->
  <Style Selector="DataGrid.files DataGridRow.group">
    <Setter Property="Background" Value="{DynamicResource FmPanelHeaderBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Icons > icon size in the main menu -->
  <Style Selector="MenuItem /template/ :is(Control)#PART_IconPresenter">
    <Setter Property="Width" Value="{DynamicResource FmMenuIconSize}" />
    <Setter Property="Height" Value="{DynamicResource FmMenuIconSize}" />
  </Style>
  <!-- Icons > 3D frame around menu icons, checked items as pressed buttons -->
  <Style Selector="Border.menuicon.framed">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
  </Style>
  <Style Selector="MenuItem.pressedcheck:checked Border.menuicon">
    <Setter Property="Background" Value="{DynamicResource FmActivePathBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource FmActiveAccentBrush}" />
  </Style>
  <Style Selector="MenuItem.pressedcheck /template/ ContentControl#PART_ToggleIconPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- Icons > "!" on hidden/system files -->
  <Style Selector="TextBlock.hiddenmark">
    <Setter Property="Foreground" Value="{DynamicResource FmMarkedBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,-3,-3" />
  </Style>
  <Style Selector="DataGrid.files.noheaders">
    <Setter Property="HeadersVisibility" Value="None" />
  </Style>
  <Style Selector="DataGrid.files DataGridCell">
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="DataGrid.files DataGridRow">
    <Setter Property="MinHeight" Value="18" />
  </Style>
  <!-- Row cursor only: no per-cell focus rectangle -->
  <Style Selector="DataGrid.files DataGridCell /template/ Rectangle#CurrentPositionVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="DataGrid.files DataGridCell /template/ Rectangle#FocusVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="DataGrid.files DataGridCell:focus /template/ Grid#FocusVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="DataGrid.files DataGridColumnHeader">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- Inactive panel: dim the cursor bar so only the active panel's cursor stands out -->
  <Style Selector="DataGrid.files.inactive DataGridRow:selected">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- File list cell text -->
  <Style Selector="TextBlock.cell">
    <Setter Property="Foreground" Value="{DynamicResource FmListTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.cell.right">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>
  <!-- Colors by file type: declared before hidden/marked so those win -->
  <Style Selector="TextBlock.cell.colored" x:DataType="vm:FileItemViewModel">
    <Setter Property="Foreground" Value="{Binding RuleBrush}" />
  </Style>
  <Style Selector="TextBlock.cell.hidden">
    <Setter Property="Foreground" Value="{DynamicResource FmHiddenBrush}" />
  </Style>
  <Style Selector="DataGrid.files DataGridRow:selected TextBlock.cell">
    <Setter Property="Foreground" Value="{DynamicResource FmCursorTextBrush}" />
  </Style>
  <Style Selector="TextBlock.cell.marked">
    <Setter Property="Foreground" Value="{DynamicResource FmMarkedBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Color > inverted selection: marked rows get the mark color as background -->
  <Style Selector="DataGrid.files.invsel TextBlock.cell.marked">
    <Setter Property="Background" Value="{DynamicResource FmMarkedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
  </Style>

  <!-- Icons -->
  <Style Selector="PathIcon.fileicon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="6,0,2,0" />
    <Setter Property="Foreground" Value="{DynamicResource FmFileBrush}" />
  </Style>
  <Style Selector="PathIcon.fileicon.dir">
    <Setter Property="Foreground" Value="{DynamicResource FmFolderBrush}" />
  </Style>

  <!-- Panel chrome -->
  <Style Selector="Border.panelframe">
    <Setter Property="BorderThickness" Value="0,2,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.panelframe.active">
    <Setter Property="BorderBrush" Value="{DynamicResource FmActiveAccentBrush}" />
  </Style>
  <!-- Header rows: drive buttons, path line -->
  <Style Selector="Button.drivebtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Margin" Value="1,2" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <!-- folder shortcuts at the right end of the drive bar (Configuration > Layout), after a separator -->
  <Style Selector="Button.drivebtn.shortcut">
    <Setter Property="Padding" Value="5,3" />
  </Style>
  <Style Selector="Border.drivebarsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,5" />
    <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
  </Style>
  <Style Selector="Image.driveimage">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <!-- Display > Show volume labels for drives -->
  <Style Selector="ComboBox TextBlock.drivelabel">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="ComboBox.labels TextBlock.drivelabel">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <!-- Layout > Flat icons off: raised drive buttons -->
  <Style Selector="ItemsControl.raised Button.drivebtn">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="Background" Value="{DynamicResource FmPanelHeaderBrush}" />
  </Style>
  <!-- the drive the panel is on (the active panel's on the shared bar): plainly marked, like the active path line
       (after the raised style: the later of two equal styles wins) -->
  <Style Selector="Button.drivebtn.current">
    <Setter Property="Background" Value="{DynamicResource FmActivePathBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FmActiveAccentBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="ItemsControl.raised Button.drivebtn.current">
    <Setter Property="BorderThickness" Value="1,1,1,2" />
  </Style>
  <Style Selector="Button.drivebtn PathIcon.driveicon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="PathIcon.driveicon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource FmDriveIconBrush}" />
  </Style>
  <Style Selector="Border.pathline">
    <Setter Property="Background" Value="{DynamicResource FmPanelHeaderBrush}" />
  </Style>
  <Style Selector="Border.pathline.active">
    <Setter Property="Background" Value="{DynamicResource FmActivePathBrush}" />
  </Style>
  <!-- Tabs of the internal terminal -->
  <Style Selector="Button.terminaltab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.terminaltab.active">
    <Setter Property="BorderBrush" Value="{DynamicResource FmActiveAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource FmTabActiveBrush}" />
  </Style>
  <!-- Buttons inside the command line (history drop-down, terminal) -->
  <Style Selector="Button.cmdline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.pathbtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.pathmask">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <Style Selector="TextBox.pathbox">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource FmPanelHeaderBrush}" />
  </Style>

  <!-- Breadcrumb path bar -->
  <Style Selector="Button.crumb, Button.crumbsep">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,1" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Button.crumbsep">
    <Setter Property="Padding" Value="0,1" />
  </Style>
  <Style Selector="Button.crumb.droptarget">
    <Setter Property="Background" Value="{DynamicResource FmActiveAccentBrush}" />
  </Style>

  <!-- Rubber band -->
  <Style Selector="Border.rubberband">
    <Setter Property="Background" Value="#332F6FDB" />
    <Setter Property="BorderBrush" Value="{DynamicResource FmActiveAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Tab strip -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MaxWidth" Value="200" />
  </Style>
  <!-- the selected tab: a faint line in the inactive panel (theme key Tabs.PassiveLine), the accent in the active one -->
  <!-- The page tabs of the main window (files, options, connections ...): a little higher than folder tabs (user's request, 19 November 2026) -->
  <Style Selector="Button.tab.pagetab">
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style Selector="Button.tab.current">
    <Setter Property="Background" Value="{DynamicResource FmTabActiveBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FmTabPassiveLineBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.tab.current.focused">
    <Setter Property="BorderBrush" Value="{DynamicResource FmActiveAccentBrush}" />
  </Style>
  <!-- Folder tabs: same width, multiline (WrapPanel wraps only when the scroll viewer limits the width), icons -->
  <Style Selector="ItemsControl.samewidth Button.tab">
    <Setter Property="Width" Value="140" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="PathIcon.tabicon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <!-- the × of the current tab: small, without a frame, a background on hover -->
  <Style Selector="Button.tabclose">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="Margin" Value="2,0,-6,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tabclose:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
  </Style>
  <Style Selector="Button.tabadd">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Button bar -->
  <Style Selector="Button.barbutton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5,3" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.barseparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="4,4" />
    <Setter Property="Background" Value="{DynamicResource FmHiddenBrush}" />
  </Style>
  <!-- a switch that is on (all looks): a soft fill -->
  <Style Selector="Button.barbutton.on">
    <Setter Property="Background" Value="#264C8DFF" />
  </Style>

  <!--
    The looks of the button bar at the top (Configuration > Layout > Button bars > Button bar style; the user's template
    of three proposals, 21 November 2026). Mica: Windows 11, 6 px corners, the active state soft blue with a line.
    Graphite: a low bar, 4 px corners, the active state a solid fill. Aurora: a floating rounded bar, round buttons, the
    active state filled violet. The view buttons sit in one segment (Border.barsegment).
  -->
  <Style Selector=":is(UserControl).tb-mica Button.barbutton, :is(UserControl).tb-graphite Button.barbutton, :is(UserControl).tb-aurora Button.barbutton">
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl).tb-mica">
    <Setter Property="Padding" Value="4,3" />
  </Style>
  <Style Selector=":is(UserControl).tb-mica Button.barbutton">
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector=":is(UserControl).tb-mica Button.barbutton.on">
    <Setter Property="Background" Value="#1F4C8DFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
  </Style>
  <Style Selector=":is(UserControl).tb-graphite">
    <Setter Property="Padding" Value="3,1" />
  </Style>
  <Style Selector=":is(UserControl).tb-graphite Button.barbutton">
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector=":is(UserControl).tb-graphite Button.barbutton.on">
    <Setter Property="Background" Value="#594C8DFF" />
  </Style>
  <Style Selector=":is(UserControl).tb-graphite Border.barseparator">
    <Setter Property="Margin" Value="5,0" />
  </Style>
  <Style Selector=":is(UserControl).tb-aurora">
    <Setter Property="Margin" Value="6,5" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
  </Style>
  <Style Selector=":is(UserControl).tb-aurora Button.barbutton">
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="MinWidth" Value="38" />
    <Setter Property="CornerRadius" Value="19" />
    <Setter Property="Margin" Value="2,0" />
  </Style>
  <Style Selector=":is(UserControl).tb-aurora Button.barbutton.on">
    <Setter Property="Background" Value="#596D4AFF" />
  </Style>
  <Style Selector=":is(UserControl).tb-aurora Border.barseparator">
    <Setter Property="Margin" Value="4,6" />
  </Style>
  <Style Selector="Border.barsegment">
    <Setter Property="Padding" Value="2" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="#14808080" />
  </Style>
  <Style Selector=":is(UserControl).tb-graphite Border.barsegment">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector=":is(UserControl).tb-aurora Border.barsegment">
    <Setter Property="Padding" Value="3" />
    <Setter Property="CornerRadius" Value="22" />
  </Style>
  <Style Selector="Border.barsegment Button.barbutton">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector=":is(UserControl).tb-mica Border.barsegment Button.barbutton.on, :is(UserControl).tb-aurora Border.barsegment Button.barbutton.on">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector=":is(UserControl).tb-aurora Border.barsegment Button.barbutton.on">
    <Setter Property="Background" Value="#806D4AFF" />
  </Style>

  <!-- Function key bar: on the window's color, only a thin line between the keys (theme key FunctionKeys.Border) -->
  <Style Selector="Button.fkey">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Padding" Value="4,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FmFunctionKeyBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Button.fkey.last">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--
    Common button design of every window:
    - the default button (Enter: OK, Search, Compare, Rename, Connect ...) is drawn in the accent color;
    - "dialog" buttons (OK / Cancel / Apply / Close rows) share a minimum width and centre their text;
    - "buttonrow" panels hold such rows with the same spacing.
  -->
  <Style Selector="Button[IsDefault=True]">
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrush}" />
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button[IsDefault=True]:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPointerOver}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
  </Style>
  <Style Selector="Button[IsDefault=True]:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPressed}" />
  </Style>
  <Style Selector="Button[IsDefault=True]:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundDisabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushDisabled}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundDisabled}" />
  </Style>
  <Style Selector="Button.dialog">
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!--
    Tool window buttons of the Windows 11 look (column sets / duplicate files templates): 32 high, corners of 5;
    "primary" in the accent color, "ghost" without a frame until the pointer is over it, "danger" in red, "icon" square.
  -->
  <Style Selector="Button.tb">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tb.icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tb.primary">
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrush}" />
  </Style>
  <Style Selector="Button.tb.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPointerOver}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
  </Style>
  <Style Selector="Button.tb.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPressed}" />
  </Style>
  <Style Selector="Button.tb.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundDisabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushDisabled}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundDisabled}" />
  </Style>
  <Style Selector="Button.tb.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tb.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tb.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tb.danger">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
  </Style>
  <Style Selector="Button.tb.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
  </Style>
  <!-- the confirming button of a destructive action (folder sizes: "Move to trash"): filled red -->
  <Style Selector="Button.tb.dangerfill">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="#C42B1C" />
    <Setter Property="BorderBrush" Value="#C42B1C" />
  </Style>
  <Style Selector="Button.tb.dangerfill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="#B02718" />
    <Setter Property="BorderBrush" Value="#B02718" />
  </Style>
  <Style Selector="Button.tb.dangerfill:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="#9A2215" />
  </Style>
  <Style Selector="Button.tb:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!--
    A check box drawn as a switch with "On" / "Off" before it (the configuration's rows: the row shows the setting's
    name, so the check box's own text is not drawn). It stays a CheckBox: IsChecked, keyboard (Space) and tests as before.
  -->
  <Style Selector="CheckBox.switch">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent">
          <Panel VerticalAlignment="Center" MinWidth="24">
            <TextBlock Name="PART_Off" Text="Off" FontSize="13" Opacity="0.75" HorizontalAlignment="Right" />
            <TextBlock Name="PART_On" Text="On" FontSize="13" Opacity="0.75" HorizontalAlignment="Right" IsVisible="False" />
          </Panel>
          <Border Name="PART_Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1" VerticalAlignment="Center"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" Background="Transparent">
            <Ellipse Name="PART_Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Fill="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox.switch:pointerover /template/ Ellipse#PART_Knob">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="3,0" />
  </Style>
  <Style Selector="CheckBox.switch:checked /template/ Border#PART_Track">
    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
  </Style>
  <Style Selector="CheckBox.switch:checked /template/ Ellipse#PART_Knob">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Fill" Value="White" />
  </Style>
  <Style Selector="CheckBox.switch:checked /template/ TextBlock#PART_Off">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="CheckBox.switch:checked /template/ TextBlock#PART_On">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="CheckBox.switch:focus-visible /template/ Border#PART_Track">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
  </Style>
  <!-- Option chips (on: accent frame and text) and filter buttons (on / off shown by their opacity), e.g. Synchronize dirs -->
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundPointerOver}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.filter:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filter:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ToggleButtonBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForeground}" />
  </Style>
  <Style Selector="CheckBox.switch:disabled">
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!--
    The connection manager and the new connection pages (the user's template, 21 November 2026). The Conn* colors are
    put into the view's resources by ConnectionLook.Apply (light and dark).
  -->
  <Style Selector=":is(UserControl).connlook TextBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl).connlook ComboBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl).connlook TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector=":is(UserControl).connlook TabItem TextBlock">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.conncard">
    <Setter Property="Background" Value="{DynamicResource ConnCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConnStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.conncard:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.conncard:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ConnCardHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConnStroke2}" />
    <Setter Property="Foreground" Value="{DynamicResource ConnText}" />
  </Style>
  <Style Selector="Button.conncard:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource ConnAccent}" />
  </Style>
  <!-- a chosen card (the checksum dialog's algorithm): the accent frame on its soft tint; its line in the accent color -->
  <Style Selector="Button.conncard.on">
    <Setter Property="Background" Value="{DynamicResource ConnAccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConnAccent}" />
  </Style>
  <Style Selector="Button.conncard.on:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.conncard.on:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ConnAccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConnAccent}" />
  </Style>
  <Style Selector="Button.conncard TextBlock.hint">
    <Setter Property="Foreground" Value="{DynamicResource ConnText3}" />
  </Style>
  <Style Selector="Button.conncard.on TextBlock.hint">
    <Setter Property="Foreground" Value="{DynamicResource ConnAccent}" />
  </Style>
  <Style Selector="ToggleButton.connchip">
    <Setter Property="Background" Value="{DynamicResource ConnControl}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConnStroke2}" />
    <Setter Property="Foreground" Value="{DynamicResource ConnText2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.connchip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ConnCardHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConnStroke2}" />
    <Setter Property="Foreground" Value="{DynamicResource ConnText}" />
  </Style>
  <Style Selector="ToggleButton.connchip:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.connchip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ConnAccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConnAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource ConnAccent}" />
  </Style>
  <!-- the favorite star of a connection's header: no frame, gold while it is a favorite -->
  <Style Selector="ToggleButton.connstar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ConnText3}" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.connstar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ConnHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.connstar:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.connstar:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="#D79A1C" />
  </Style>
  <!-- the list of connections: a quiet selection (not the accent color), rounded rows -->
  <Style Selector="ListBox.conntree ListBoxItem">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.conntree ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.conntree ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ConnHover}" />
    <Setter Property="Foreground" Value="{DynamicResource ConnText}" />
  </Style>
  <Style Selector="ListBox.conntree ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.conntree ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.conntree ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ConnSelected}" />
    <Setter Property="Foreground" Value="{DynamicResource ConnText}" />
  </Style>
  <Style Selector="Expander.connmore">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource ConnCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConnStroke}" />
  </Style>
  <Style Selector="Expander.connmore /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="{DynamicResource ConnCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConnStroke}" />
    <Setter Property="MinHeight" Value="52" />
  </Style>
  <Style Selector="Expander.connmore /template/ Border#ExpanderContent">
    <Setter Property="Background" Value="{DynamicResource ConnCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConnStroke}" />
    <Setter Property="Padding" Value="16,4,16,12" />
  </Style>
  <Style Selector="StackPanel.buttonrow">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <!-- Configuration: a JSON list whose text was not taken (also while it has the focus) -->
  <Style Selector="TextBox.jsoninvalid /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="IndianRed" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox.jsoninvalid:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="IndianRed" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox.jsoninvalid:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="IndianRed" />
  </Style>
  <Style Selector="Button.fkey:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FmFunctionKeyBorderBrush}" />
  </Style>
  <!-- a key that cannot run now (F3 on ".."): the bar's background stays, only the text fades (user's request, 21 November 2026) -->
  <Style Selector="Button.fkey:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FmFunctionKeyBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
  </Style>
  <Style Selector="Button.tool">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!--
    ================================================================================================================
    The main window after the user's template (main-window-template, 22 November 2026). The colors stay the theme's
    (Fm* brushes, theme keys), the shapes are the template's: rounded panel cards on the window's background, the
    drive chips with a used-space bar, rounded folder tabs, a path row with the drive box, a soft cursor, the middle
    bar, a plain command line and function keys with their key caps. Later than the styles above: they win.
    ================================================================================================================
  -->
  <!-- menu bar: more room around the items; the open item keeps the look of the selected tab (the theme's
       Menu.HoverBackground and the accent line below, the styles at the top of this file) -->
  <Style Selector="Menu#MainMenu">
    <Setter Property="Padding" Value="6,3" />
  </Style>
  <Style Selector="Menu#MainMenu > MenuItem">
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Padding" Value="9,3" />
  </Style>

  <!-- the panel: a card with rounded corners; the active one with the accent around it -->
  <Style Selector="Border.panelframe">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource NcMwStrokeBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource NcMwCardBrush}" />
  </Style>
  <!-- one sharp line in the accent color (a half-transparent line with a ring around it looked blurred at the corners) -->
  <Style Selector="Border.panelframe.active">
    <Setter Property="BorderBrush" Value="{DynamicResource FmActiveAccentBrush}" />
  </Style>
  <!-- a tab of the other side dragged over this panel: it goes here when let go -->
  <Style Selector="views|PanelSideView.droptarget Border.panelframe">
    <Setter Property="BorderBrush" Value="{DynamicResource FmActiveAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource NcMwAccentSoftBrush}" />
  </Style>
  <!-- the bars inside the card: drive chips, tabs, path row, status -->
  <Style Selector="Border.mwbar">
    <Setter Property="Background" Value="{DynamicResource FmDriveBarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NcMwStrokeBrush}" />
  </Style>

  <!-- drive chips: a letter and a little used-space bar; the panel's drive raised -->
  <Style Selector="Button.drivebtn">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource NcMutedBrush}" />
  </Style>
  <Style Selector="Button.drivebtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NcTextBrush}" />
  </Style>
  <Style Selector="Button.drivebtn.current, ItemsControl.raised Button.drivebtn.current">
    <Setter Property="Background" Value="{DynamicResource NcMwChipBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NcTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.drivebtn.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource NcMwChipShadow}" />
  </Style>
  <Style Selector="Button.drivebtn.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwChipBrush}" />
  </Style>
  <Style Selector="Image.driveimage">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Button.drivebtn PathIcon.driveicon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Border.drivebarsep">
    <Setter Property="Margin" Value="6,6" />
    <Setter Property="Background" Value="{DynamicResource NcMwStrongStrokeBrush}" />
  </Style>
  <!-- the used-space bar of a drive (chip, drive box, free space of the path row) -->
  <Style Selector="Border.usage">
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource NcMwStrongStrokeBrush}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.usage > Border">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource FmActiveAccentBrush}" />
  </Style>
  <Style Selector="Border.usage.low > Border">
    <Setter Property="Background" Value="{DynamicResource NcBadBrush}" />
  </Style>

  <!-- folder tabs: rounded at the top; the selected one is part of the card, with the accent line in the active panel -->
  <!-- the strip on the bar color, the tabs standing on its bottom edge -->
  <Style Selector="Border#TabStripHost">
    <Setter Property="Padding" Value="6,4,6,0" />
  </Style>
  <Style Selector="Border#TabStripHost ItemsControl#TabStrip">
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="Button.tab">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MaxWidth" Value="180" />
    <Setter Property="Padding" Value="10,0,6,0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="CornerRadius" Value="6,6,0,0" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource NcMutedBrush}" />
  </Style>
  <!-- the accent line at the top of the current tab of the active panel (8 px in from both sides) -->
  <Style Selector="Border.tabline">
    <Setter Property="Height" Value="2" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="-2,-1,2,0" />
    <Setter Property="CornerRadius" Value="0,0,2,2" />
    <Setter Property="Background" Value="{DynamicResource FmActiveAccentBrush}" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.tab.current.focused Border.tabline">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tab.current">
    <Setter Property="Background" Value="{DynamicResource NcMwCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NcMwStrokeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NcTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.tab.current.focused">
    <Setter Property="BorderBrush" Value="{DynamicResource NcMwStrokeBrush}" />
  </Style>
  <Style Selector="Button.tab.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NcMwStrokeBrush}" />
  </Style>
  <!-- the page tabs of the window (files, options ...) keep their own look -->
  <Style Selector="Button.tab.pagetab">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style Selector="Button.tabclose">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource NcFaintBrush}" />
  </Style>
  <Style Selector="Button.tabclose:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwPressBrush}" />
  </Style>
  <!-- new tab: only the plus in the accent color, no background and no frame (the user's request, 22 November 2026) -->
  <Style Selector="Button.tabadd">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="4,0,0,2" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FmActiveAccentBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.tabadd:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tabadd:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FmActiveAccentBrush}" />
  </Style>
  <!-- under the mouse the plus grows a little -->
  <Style Selector="Button.tabadd PathIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
  </Style>
  <Style Selector="Button.tabadd:pointerover PathIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>

  <!-- the hotlist and history buttons at the end of the path row: icons in a square button -->
  <Style Selector="Button.pathend">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.pathend:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwHoverBrush}" />
  </Style>
  <Style Selector="Button.pathend:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwPressBrush}" />
  </Style>

  <!-- path row: the drive box, the crumbs, the free space -->
  <Style Selector="Border.pathline, Border.pathline.active">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.drivebox">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,0,6,0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource NcMwStrokeBrush}" />
    <Setter Property="Background" Value="{DynamicResource NcMwChipBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.drivebox:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwChipBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NcMwStrongStrokeBrush}" />
  </Style>
  <Style Selector="Button.drivebox.open /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FmActiveAccentBrush}" />
  </Style>
  <Style Selector="Button.crumb, Button.crumbsep">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource NcMutedBrush}" />
  </Style>
  <Style Selector="Button.crumbsep">
    <Setter Property="Padding" Value="1,2" />
    <Setter Property="Foreground" Value="{DynamicResource NcFaintBrush}" />
  </Style>
  <Style Selector="Button.crumb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwPressBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NcTextBrush}" />
  </Style>
  <Style Selector="Button.crumb.last">
    <Setter Property="Foreground" Value="{DynamicResource NcTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBox.pathbox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource NcMonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="TextBlock.freetext">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource NcFaintBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- the drive box's list -->
  <!-- the hotlist menu in the look of the drive box's list: a card, rounded rows -->
  <Style Selector="MenuFlyoutPresenter.mwmenu">
    <Setter Property="Background" Value="{DynamicResource NcMwCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NcMwStrongStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="260" />
  </Style>
  <Style Selector="MenuFlyoutPresenter.mwmenu MenuItem">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="MenuFlyoutPresenter.mwmenu Separator">
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="Background" Value="{DynamicResource NcMwStrokeBrush}" />
  </Style>

  <!-- opaque: the list background of the light theme is transparent, the panel showed through the open list -->
  <Style Selector="Border.mwpopup">
    <Setter Property="Background" Value="{DynamicResource NcMwCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NcMwStrongStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="{DynamicResource NcMwPopupShadow}" />
    <Setter Property="Margin" Value="8,0,8,16" />
  </Style>
  <Style Selector="ListBox.drivelist">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.drivelist ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.drivelist ListBoxItem.header">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="10,6,10,2" />
  </Style>
  <Style Selector="ListBox.drivelist ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwHoverBrush}" />
  </Style>
  <Style Selector="ListBox.drivelist ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NcTextBrush}" />
  </Style>

  <!-- the file list: header in quiet text, the cursor a soft accent with a line, the inactive panel's only a line -->
  <Style Selector="DataGrid.files DataGridColumnHeader">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource NcMutedBrush}" />
  </Style>
  <Style Selector="DataGrid.files /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
    <Setter Property="Fill" Value="{DynamicResource NcMwStrokeBrush}" />
  </Style>
  <Style Selector="DataGrid.files DataGridRow">
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="DataGrid.files DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource NcMwCursorBrush}" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Stroke" Value="{DynamicResource NcMwCursorLineBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="RadiusX" Value="4" />
    <Setter Property="RadiusY" Value="4" />
  </Style>
  <Style Selector="DataGrid.files.inactive DataGridRow:selected">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- the inactive panel keeps its cursor, faded (the user's request, 22 November 2026: it seemed to disappear) -->
  <Style Selector="DataGrid.files.inactive DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource NcMwCursorInactiveBrush}" />
    <Setter Property="Stroke" Value="{DynamicResource NcMwCursorInactiveLineBrush}" />
  </Style>
  <!-- on the soft cursor the text keeps its colors (file type, hidden, marked) -->
  <Style Selector="DataGrid.files DataGridRow:selected TextBlock.cell">
    <Setter Property="Foreground" Value="{DynamicResource FmListTextBrush}" />
  </Style>
  <Style Selector="DataGrid.files DataGridRow:selected TextBlock.cell.colored" x:DataType="vm:FileItemViewModel">
    <Setter Property="Foreground" Value="{Binding RuleBrush}" />
  </Style>
  <Style Selector="DataGrid.files DataGridRow:selected TextBlock.cell.hidden">
    <Setter Property="Foreground" Value="{DynamicResource FmHiddenBrush}" />
  </Style>
  <Style Selector="DataGrid.files DataGridRow:selected TextBlock.cell.marked">
    <Setter Property="Foreground" Value="{DynamicResource FmMarkedBrush}" />
  </Style>
  <Style Selector="TextBlock.cell">
    <Setter Property="Margin" Value="6,0" />
  </Style>

  <!-- status line of the panel -->
  <Style Selector="Border.mwstatus">
    <Setter Property="Background" Value="{DynamicResource FmStatusBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NcMwStrokeBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.mwstatus TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource NcMutedBrush}" />
  </Style>

  <!-- the bar between the panels: round icon buttons in a narrow column -->
  <Style Selector="Border#VerticalBarHost Button.barbutton">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border#VerticalBarHost Button.barbutton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwHoverBrush}" />
  </Style>
  <Style Selector="Border#VerticalBarHost Border.barseparator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Margin" Value="0,5" />
    <Setter Property="Background" Value="{DynamicResource NcMwStrongStrokeBrush}" />
  </Style>
  <!-- the button bar at the top: the same soft hover -->
  <Style Selector="Border#TopBarHost Button.barbutton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwHoverBrush}" />
  </Style>
  <Style Selector="Border#TopBarHost Border.barseparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource NcMwStrongStrokeBrush}" />
  </Style>

  <!-- command line: a plain box in a monospaced font, the prompt before it -->
  <Style Selector="TextBox#CommandLine">
    <Setter Property="FontFamily" Value="{DynamicResource NcMonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.prompt">
    <Setter Property="FontFamily" Value="{DynamicResource NcMonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource NcMutedBrush}" />
  </Style>

  <!-- function keys: no frames, the key cap before the name, a soft hover -->
  <Style Selector="Button.fkey">
    <Setter Property="Height" Value="30" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource NcMutedBrush}" />
  </Style>
  <Style Selector="Button.fkey:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NcMwHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource NcTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.fkey.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource NcBadBrush}" />
  </Style>
  <Style Selector="Button.fkey:disabled /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.keycap">
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="BorderBrush" Value="{DynamicResource NcMwStrongStrokeBrush}" />
    <Setter Property="Background" Value="{DynamicResource NcMwChipBrush}" />
  </Style>
  <Style Selector="Border.keycap TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NcTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
