<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>NextCommander</AssemblyName>
    <RootNamespace>NextCommander.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NextCommander.ico</ApplicationIcon>
    <Product>NextCommander</Product>
    <Description>Çift panelli, çapraz platform dosya yöneticisi</Description>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.HtmlRenderer" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="LibVLCSharp.Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NextCommander.Core\NextCommander.Core.csproj" />
    <ProjectReference Include="..\NextCommander.Vfs.Local\NextCommander.Vfs.Local.csproj" />
    <ProjectReference Include="..\NextCommander.Vfs.Archive\NextCommander.Vfs.Archive.csproj" />
    <ProjectReference Include="..\NextCommander.Vfs.Remote\NextCommander.Vfs.Remote.csproj" />
    <ProjectReference Include="..\NextCommander.Columns\NextCommander.Columns.csproj" />
    <ProjectReference Include="..\NextCommander.Platform\NextCommander.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\NextCommander.png" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="NextCommander.App.Localization.%(Filename).json" />
    <!-- Language and color theme files next to the program: users can add or edit them (see README) -->
    <None Include="Localization\*.json" Link="Languages\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Themes\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="IconPacks\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NextCommander.App.Tests" />
  </ItemGroup>

  <!--
    Plugins shipped with the application: built with it but not referenced; their assembly and plugin.json go to
    plugins/<folder> next to the program (also in the publish folder, outside the single file).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Plugins\NextCommander.Plugin.Rclone\NextCommander.Plugin.Rclone.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="NcShippedPlugin" PluginFolder="rclone" />
    <ProjectReference Include="..\Plugins\NextCommander.Plugin.Git\NextCommander.Plugin.Git.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="NcShippedPlugin" PluginFolder="git" />
    <ProjectReference Include="..\Plugins\NextCommander.Plugin.Sqlite\NextCommander.Plugin.Sqlite.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="NcShippedPlugin" PluginFolder="sqlite" />
    <ProjectReference Include="..\Plugins\NextCommander.Plugin.Docker\NextCommander.Plugin.Docker.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="NcShippedPlugin" PluginFolder="docker" />
    <ProjectReference Include="..\Plugins\NextCommander.Plugin.Kubernetes\NextCommander.Plugin.Kubernetes.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="NcShippedPlugin" PluginFolder="kubernetes" />
    <ProjectReference Include="..\Plugins\NextCommander.Plugin.DiskImage\NextCommander.Plugin.DiskImage.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="NcShippedPlugin" PluginFolder="diskimage" />
    <ProjectReference Include="..\Plugins\NextCommander.Plugin.Viewers\NextCommander.Plugin.Viewers.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="NcShippedPlugin" PluginFolder="viewers" />
    <ProjectReference Include="..\Plugins\NextCommander.Plugin.Packages\NextCommander.Plugin.Packages.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="NcShippedPlugin" PluginFolder="packages" />
    <ProjectReference Include="..\Plugins\NextCommander.Plugin.Repositories\NextCommander.Plugin.Repositories.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="NcShippedPlugin" PluginFolder="repositories" />
  </ItemGroup>
  <Target Name="NcPluginFiles" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_NcPluginProject Include="@(NcShippedPlugin->'%(MSBuildSourceProjectFile)')" />
      <_NcPluginFile Include="@(NcShippedPlugin->'%(FullPath)')" />
      <!-- the manifest from the plugin's source folder -->
      <_NcPluginFile Include="@(_NcPluginProject->'%(RootDir)%(Directory)plugin.json')" />
      <_NcPluginFile Include="@(NcShippedPlugin->'%(RootDir)%(Directory)%(Filename).pdb')"
                     Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb') and '$(DebugType)' != 'none'" />
      <!-- the plugin's .deps.json (its own packages are resolved through it) -->
      <_NcPluginFile Include="@(NcShippedPlugin->'%(RootDir)%(Directory)%(Filename).deps.json')"
                     Condition="Exists('%(RootDir)%(Directory)%(Filename).deps.json')" />
      <_NcPluginFile Update="@(_NcPluginFile)" RelativePath="plugins\%(PluginFolder)\%(Filename)%(Extension)" />
      <!-- the plugin's own translations: languages/*.json of its source folder -->
      <_NcPluginSourceFolder Include="@(NcShippedPlugin->'%(MSBuildSourceProjectFile)')" />
      <_NcPluginLanguage Include="%(_NcPluginSourceFolder.RootDir)%(_NcPluginSourceFolder.Directory)languages\*.json"
                         PluginFolder="%(_NcPluginSourceFolder.PluginFolder)" />
      <_NcPluginFile Include="@(_NcPluginLanguage)" RelativePath="plugins\%(PluginFolder)\languages\%(Filename)%(Extension)" />
    </ItemGroup>
    <!--
      a plugin's own packages (e.g. DiscUtils): the plugin project gives them through its NcPluginDependencies target
      (asked, not looked for in its output folder: with "dotnet build -o" every project's output is in one folder)
    -->
    <MSBuild Projects="@(_NcPluginProject)" Targets="NcPluginDependencies" SkipNonexistentTargets="true"
             Properties="NcPluginFolder=%(_NcPluginProject.PluginFolder)" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishSingleFile">
      <Output TaskParameter="TargetOutputs" ItemName="_NcPluginDependency" />
    </MSBuild>
    <ItemGroup>
      <_NcPluginFile Include="@(_NcPluginDependency)" RelativePath="plugins\%(PluginFolder)\%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
  <!-- the plugin files with their RelativePath, for the test project (it puts them next to its own output) -->
  <Target Name="NcPluginFileList" DependsOnTargets="NcPluginFiles" Returns="@(_NcPluginFile)" />
  <Target Name="NcCopyPlugins" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="NcPluginFiles">
    <Copy SourceFiles="@(_NcPluginFile)" DestinationFiles="@(_NcPluginFile->'$(OutDir)%(RelativePath)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="NcPublishPlugins" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="NcPluginFiles">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_NcPluginFile)" RelativePath="%(_NcPluginFile.RelativePath)"
                             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
