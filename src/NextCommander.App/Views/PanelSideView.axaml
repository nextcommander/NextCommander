<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextCommander.App.ViewModels"
             xmlns:views="using:NextCommander.App.Views"
             x:Class="NextCommander.App.Views.PanelSideView"
             x:DataType="vm:TabSideViewModel">
  <DockPanel x:Name="Root">
    <!-- Tab strip (hidden with a single tab unless "always show tabs") -->
    <Border x:Name="TabStripHost" DockPanel.Dock="Top" IsVisible="{Binding ShowTabStrip}" Background="{DynamicResource FmTabStripBrush}">
      <DockPanel>
        <Button x:Name="NewTabButton" DockPanel.Dock="Right" Classes="tabadd" ToolTip.Tip="New tab (Ctrl+T)" Focusable="False">
          <PathIcon Data="{StaticResource MiPlus}" />
        </Button>
        <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}" Classes.samewidth="{Binding TabsSameWidth}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PanelViewModel">
                <Button Classes="tab" Classes.current="{Binding IsCurrentTab}" Classes.focused="{Binding IsActive}"
                        Tag="{Binding}" Focusable="False" ToolTip.Tip="{Binding PathText}">
                  <Panel>
                  <!-- the tab's own color (Tabs > color) fills it -->
                  <Border Background="{Binding TabBrush}" Margin="-10,0,-6,0" CornerRadius="5,5,0,0" />
                  <Border Classes="tabline" />
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Panel IsVisible="{Binding ShowTabIcon}" Width="12" Height="12" VerticalAlignment="Center">
                      <PathIcon Classes="tabicon" Data="{StaticResource MiFolderOpen}" Foreground="{DynamicResource FmFolderBrush}">
                        <PathIcon.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsLocked" />
                            <Binding Path="!HasOwnTabIcon" />
                          </MultiBinding>
                        </PathIcon.IsVisible>
                      </PathIcon>
                      <!-- drives and user folders of the system (documents, downloads, desktop ...) show the icon the system gives them -->
                      <Panel IsVisible="{Binding !IsLocked}">
                        <Image Width="12" Height="12" Source="{Binding TabIcon}" IsVisible="{Binding TabIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <PathIcon Classes="tabicon" Data="{Binding TabGlyph}" Foreground="{DynamicResource FmFolderBrush}"
                                  IsVisible="{Binding TabGlyph, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </Panel>
                      <PathIcon Classes="tabicon" Data="{StaticResource MiLock}" IsVisible="{Binding IsLocked}" Foreground="DarkOrange" />
                    </Panel>
                    <TextBlock Classes="noloc" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <!-- the current tab gets a close button (when it is not the only tab) -->
                    <Button Classes="tabclose" Content="×" Focusable="False" ToolTip.Tip="Close the tab (Ctrl+W)" Tag="{Binding}">
                      <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="IsCurrentTab" />
                          <Binding Path="$parent[ItemsControl].((vm:TabSideViewModel)DataContext).CanCloseTabs" />
                        </MultiBinding>
                      </Button.IsVisible>
                    </Button>
                  </StackPanel>
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <!-- the file panel; a tool such as the connection manager can take its place for a while -->
    <!-- the Quick View can share the side with the file list (below or right of it; PanelSideView.ShowPreview) -->
    <Grid x:Name="SplitGrid">
      <Panel x:Name="FileArea">
        <views:FilePanelView x:Name="FilePanel" DataContext="{Binding ActiveTab}" />
        <ContentControl x:Name="OverlayHost" IsVisible="False" />
      </Panel>
      <GridSplitter x:Name="PreviewSplitter" IsVisible="False" Background="Transparent" />
      <ContentControl x:Name="PreviewHost" IsVisible="False" />
    </Grid>
  </DockPanel>
</UserControl>
