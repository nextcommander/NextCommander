<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Docker containers as a plugin: the files of a container in a panel (docker://<container>/path), through the
    installed docker command line. The application builds it and copies it with plugin.json and its languages folder
    into plugins/docker next to the program.
  -->
  <PropertyGroup>
    <RootNamespace>NextCommander.Plugin.Docker</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\NextCommander.Core\NextCommander.Core.csproj" Private="false" />
  </ItemGroup>
  <!-- plugin.json and languages are taken from this folder by the application's build (not copied here: they would land next to the program too) -->
  <ItemGroup>
    <InternalsVisibleTo Include="NextCommander.Core.Tests" />
  </ItemGroup>
</Project>
