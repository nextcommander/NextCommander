<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1515/CA1711 etc. are too noisy for an application codebase -->
    <NoWarn>$(NoWarn);CA1515;CA1711;CA1716;CA1720;CA1805;CA1812;CA1848;CA1852;CA2007;CA1031;CA1062;CA1303;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1724;CA1819;CA1001;CA1063;CA1816;CA2000;CA5394;CA1859;CA1002;CA1822;CA1050;CA1034;CA1708;CA1056;CA1054;CA1055;CA2234;CA1823</NoWarn>
    <Authors>Muhammed Şahin</Authors>
    <Product>NextCommander</Product>
    <Copyright>© 2026 NextCommander</Copyright>
    <!--
      Version: YY.MM.build (e.g. 26.11.1060). Year and month are those of the commit being built (the same commit
      always gets the same version); without git, those of the build date. The build number counts the git commits:
      NcBuildNumberStart at the commit number NcBuildNumberStartCommit (the commit that introduced it), one more with
      every commit after it. Without git (a source copy) the build number is NcBuildNumberStart.
      Version / InformationalVersion keep the month with two digits (26.01.1060); the numeric versions (assembly,
      file, MSIX) cannot have a leading zero: NcNumericVersion is 26.1.1060.
      The NcVersion target sets them before the assembly attributes are written; build/publish.ps1 reads them with
      "dotnet msbuild -t:NcVersion -getProperty:Version -getProperty:NcNumericVersion".
    -->
    <NcBuildNumberStart>1000</NcBuildNumberStart>
    <NcBuildNumberStartCommit>6</NcBuildNumberStartCommit>
    <Version>$([System.DateTime]::Now.ToString('yy.MM')).$(NcBuildNumberStart)</Version>
    <!-- no "+commit" suffix in the informational version: the app shows it as it is -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="NcVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;GetAssemblyAttributes">
    <Exec Command="git rev-list --count HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_NcCommitCount" />
      <Output TaskParameter="ExitCode" PropertyName="_NcGitExitCode" />
    </Exec>
    <!-- year and month of the commit, "26.11" -->
    <Exec Command="git log -1 --format=%25%25cd --date=format:%25%25y.%25%25m" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_NcCommitMonth" />
      <Output TaskParameter="ExitCode" PropertyName="_NcGitDateExitCode" />
    </Exec>
    <PropertyGroup>
      <_NcBuildNumber>$(NcBuildNumberStart)</_NcBuildNumber>
      <_NcBuildNumber Condition="'$(_NcGitExitCode)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_NcCommitCount)', '^\d+$'))">$([MSBuild]::Add($(NcBuildNumberStart), $([MSBuild]::Subtract($(_NcCommitCount), $(NcBuildNumberStartCommit)))))</_NcBuildNumber>
      <_NcYearMonth>$([System.DateTime]::Now.ToString('yy.MM'))</_NcYearMonth>
      <_NcYearMonth Condition="'$(_NcGitDateExitCode)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_NcCommitMonth)', '^\d\d\.\d\d$'))">$(_NcCommitMonth)</_NcYearMonth>
      <Version>$(_NcYearMonth).$(_NcBuildNumber)</Version>
      <NcNumericVersion>$([System.Int32]::Parse($(_NcYearMonth.Substring(0, 2)))).$([System.Int32]::Parse($(_NcYearMonth.Substring(3, 2)))).$(_NcBuildNumber)</NcNumericVersion>
      <AssemblyVersion>$(NcNumericVersion).0</AssemblyVersion>
      <FileVersion>$(NcNumericVersion).0</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
