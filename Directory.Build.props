<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1515/CA1711 etc. are too noisy for an application codebase -->
    <NoWarn>$(NoWarn);CA1515;CA1711;CA1716;CA1720;CA1805;CA1812;CA1848;CA1852;CA2007;CA1031;CA1062;CA1303;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1724;CA1819;CA1001;CA1063;CA1816;CA2000;CA5394;CA1859;CA1002;CA1822;CA1050;CA1034;CA1708;CA1056;CA1054;CA1055;CA2234;CA1823</NoWarn>
    <Authors>Muhammed Şahin</Authors>
    <Product>NextCommander</Product>
    <Copyright>© 2026 NextCommander</Copyright>
    <!--
      Version: YY.MM.NNN (e.g. 26.11.071; user's requests, 15 November 2026, three digits since 20 November 2026;
      before: four). Year and month are those of the commit being built, so the same commit always gets the same
      version; NNN is the number of that commit within its month, three digits (more after the 999th commit of a
      month), starting at 000 with the first commit of every new month (the commits of the history whose commit date
      is in the same month, minus one). Without git (a source copy): the build date's month and 000.
      Version / InformationalVersion keep the leading zeros (26.01.005); the numeric versions (assembly, file,
      deb / rpm, macOS bundle) cannot have them: NcNumericVersion is 26.1.5.
      The NcVersion target sets them before the assembly attributes are written; build/publish.ps1 reads them with
      "dotnet msbuild -t:NcVersion -getProperty:Version -getProperty:NcNumericVersion".
    -->
    <Version>$([System.DateTime]::Now.ToString('yy.MM')).000</Version>
    <!-- no "+commit" suffix in the informational version: the app shows it as it is -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="NcVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;GetAssemblyAttributes">
    <!-- year and month of the commit, "26.11" -->
    <Exec Command="git log -1 --format=%25%25cd --date=format:%25%25y.%25%25m" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_NcCommitMonth" />
      <Output TaskParameter="ExitCode" PropertyName="_NcGitDateExitCode" />
    </Exec>
    <!-- the month of every commit of the history ("26.11;26.11;26.10;..."): the commits of the same month are counted -->
    <Exec Command="git log --format=%25%25cd --date=format:%25%25y.%25%25m HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_NcMonths" />
      <Output TaskParameter="ExitCode" PropertyName="_NcGitLogExitCode" />
    </Exec>
    <PropertyGroup>
      <_NcGit>false</_NcGit>
      <_NcGit Condition="'$(_NcGitDateExitCode)' == '0' and '$(_NcGitLogExitCode)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_NcCommitMonth)', '^\d\d\.\d\d$'))">true</_NcGit>
      <_NcYearMonth>$([System.DateTime]::Now.ToString('yy.MM'))</_NcYearMonth>
      <_NcYearMonth Condition="$(_NcGit)">$(_NcCommitMonth)</_NcYearMonth>
      <_NcBuildNumber>0</_NcBuildNumber>
      <!-- occurrences of "yy.mm" in the list (each is five characters), minus one: the first commit of a month is 000 -->
      <_NcBuildNumber Condition="$(_NcGit)">$([MSBuild]::Subtract($([MSBuild]::Divide($([MSBuild]::Subtract($(_NcMonths.Length), $(_NcMonths.Replace($(_NcYearMonth), '').Length))), 5)), 1))</_NcBuildNumber>
      <_NcBuildNumber>$([System.Int32]::Parse($(_NcBuildNumber)))</_NcBuildNumber>
      <Version>$(_NcYearMonth).$(_NcBuildNumber.PadLeft(3, '0'))</Version>
      <NcNumericVersion>$([System.Int32]::Parse($(_NcYearMonth.Substring(0, 2)))).$([System.Int32]::Parse($(_NcYearMonth.Substring(3, 2)))).$(_NcBuildNumber)</NcNumericVersion>
      <AssemblyVersion>$(NcNumericVersion).0</AssemblyVersion>
      <FileVersion>$(NcNumericVersion).0</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
