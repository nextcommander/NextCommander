<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NextCommander.App.ViewModels"
             x:Class="NextCommander.App.Views.DirectoryTreeView">
  <UserControl.Styles>
    <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Styles>
  <TreeView x:Name="Tree" DragDrop.AllowDrop="True" FontSize="12">
    <TreeView.ItemTemplate>
      <TreeDataTemplate DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <PathIcon Width="14" Height="14" Data="{StaticResource FmFolderIcon}" Foreground="{DynamicResource FmFolderBrush}"
                    IsVisible="{Binding !IsPlaceholder}" />
          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
        </StackPanel>
      </TreeDataTemplate>
    </TreeView.ItemTemplate>
  </TreeView>
</UserControl>
